{
  "name": "guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Guardian: vigilante autonomo para vehiculo 12V con app movil",
  "scripts": {
    "dev:backend": "pnpm --filter backend run start:dev",
    "dev:mobile": "pnpm --filter mobile run start",
    "dev": "node scripts/dev.js",
    "build": "pnpm run build:backend",
    "build:backend": "pnpm --filter backend run build",
    "test": "pnpm run test:backend && pnpm run test:mobile",
    "test:backend": "pnpm --filter backend run test",
    "test:mobile": "pnpm --filter mobile run test",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:e2e": "pnpm --filter backend run test:e2e",
    "audit:prod": "node scripts/audit-prod.js",
    "check:scripts": "node --check backend/scripts/prod-sim.js && node --check backend/scripts/prod-sim-day.js && node --check backend/scripts/prod-sim-locate.js && node --check backend/scripts/smoke-built.js && bash -n backend/scripts/prod-sim.sh firmware/production/check-security-config.sh",
    "lint": "pnpm --filter backend run lint && pnpm --filter mobile run lint",
    "typecheck": "pnpm --filter backend exec tsc --noEmit && pnpm --filter mobile exec tsc --noEmit",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev",
    "db:deploy": "pnpm --filter backend exec prisma migrate deploy",
    "db:studio": "pnpm --filter backend exec prisma studio",
    "db:generate": "pnpm --filter backend exec prisma generate",
    "setup": "node scripts/setup.js",
    "storybook": "pnpm --filter mobile run storybook",
    "storybook:web": "pnpm --filter mobile run storybook:web",
    "build:storybook": "pnpm --filter mobile run build:storybook",
    "test:storybook": "pnpm --filter mobile run test:storybook",
    "clean": "node scripts/clean.js",
    "kill:ports": "node scripts/kill-port.js",
    "kill:backend": "node scripts/kill-port.js 3000",
    "kill:mobile": "node scripts/kill-port.js 8081"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.2",
      "js-yaml": "4.3.2",
      "lodash": "4.18.0",
      "multer": "2.5.0",
      "node-forge": "1.4.3",
      "qs": "6.17.1",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "@storybook/react": "10.3.1",
      "@storybook/react-dom-shim": "10.3.1",
      "@storybook/react-native-theming": "10.3.1",
      "@storybook/react-native-ui": "10.3.1",
      "@storybook/react-native-ui-common": "10.3.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": ">=5 <7",
        "valibot": ">=1.2.0 <2"
      }
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "better-auth"
    ]
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}

// Guardian schema: Better Auth tables + dominio Guardian.
// Las tablas user/session/account/verification las genera/consume Better Auth
// (npx @better-auth/cli generate --adapter prisma si cambia la version).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Better Auth ============

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  devices       Device[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============ Dominio Guardian ============

enum DeviceState {
  ARMED // aparcado y armado
  TRIP // viaje autorizado activo
  WORKSHOP // modo taller temporal
}

// Handshake de confirmacion del viaje. Separado de DeviceState: el modo
// (ARMED/TRIP/WORKSHOP) es el estado de seguridad; tripState rastrea si el
// desarme fue solicitado y confirmado. Sin canal ACK con el dispositivo aun,
// el backend auto-confirma (CONFIRMED) — ver startTrip. Contrato listo para
// el ACK fisico (PR futuro): nunca se finge confirmacion de dispositivo.
enum TripState {
  IDLE // sin viaje
  REQUESTED // solicitado, pendiente de confirmar
  CONFIRMED // confirmado (hoy: por el backend)
}

enum IncidentKind {
  suspected_movement
  power_lost
}

enum IncidentState {
  OPEN // abierto, sin revisar
  ACKNOWLEDGED // "Revisado" por el dueno — NO desarma
  CLOSED // cerrado explicitamente
}

// Canal backend -> dispositivo (PR2). La orden viaja SIEMPRE por este canal
// autenticado; cualquier senal de wake es best-effort y diferida a firmware
// (docs v0.6 S8): despertar no es autorizar. El dispositivo hace poll con
// K_command; el ACK es el gnss_fix que llega por /v1/events con commandId.
enum CommandType {
  LOCATE_NOW
}

enum CommandStatus {
  PENDING // creado, esperando que el dispositivo lo recoja y responda
  ACKED // gnss_fix recibido con su commandId (resultEventId apunta al evento)
  EXPIRED // TTL agotado sin respuesta (expiracion lazy al leer)
}

model Device {
  id         String      @id @default(cuid())
  name       String
  // Clave raiz HMAC del dispositivo (K_root). Cifrada en reposo con AES-256-GCM
  // (master key en env GUARDIAN_SECRET_KEY, fuera de la BD): formato
  // `enc:v1:iv:tag:ct`. Ver src/devices/secret-crypto.ts. Los secretos legado
  // en claro (sin prefijo) siguen validando y se re-cifran al reescribirse.
  secret     String
  // Propiedad diferida al claim: un dispositivo aprovisionado en banco/fabrica
  // nace SIN dueño (ownerId null) y en ventana de pairing. El dueño lo reclama
  // con un codigo de un solo uso desde la app (presencia fisica en software;
  // el reto BLE criptografico queda diferido a firmware, docs §6). Ver claim*.
  ownerId    String?
  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Hash SHA-256 del codigo de claim (nunca el codigo en claro). Se pone al
  // aprovisionar y se borra (null) al reclamar: es de un solo uso. @unique
  // impide dos codigos activos con el mismo hash (Postgres admite varios NULL,
  // asi que los codigos ya quemados no chocan entre si).
  claimCodeHash    String?   @unique
  // Fin de la ventana de pairing. Fuera de ella el claim se rechaza; se borra
  // al reclamar. Un codigo sin ventana viva no vale.
  pairingExpiresAt DateTime?
  // Momento del claim (null = aun sin dueño). Trazabilidad del alta.
  claimedAt        DateTime?
  state      DeviceState @default(ARMED)
  // Handshake del viaje (ver enum TripState). workshopUntil expira el modo
  // taller: mientras exista, el dispositivo esta en WORKSHOP, nunca ARMED.
  tripState     TripState @default(IDLE)
  workshopUntil DateTime?
  lastSeq    Int         @default(0)
  lastSeenAt DateTime?
  // Ultimo estado denormalizado: evita escanear device_events para la
  // "ultima posicion/energia conocida" (dashboard + preview de mapa).
  lastLat       Float?
  lastLon       Float?
  lastFixAt     DateTime?
  // Telemetria de energia (protocolo v2, siempre presente en cada evento):
  // rail del vehiculo, reserva interna del Guardian y cual alimenta ahora.
  lastVehicleMv     Int?
  lastReserveMv Int?
  lastPowerSource String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  events     DeviceEvent[]
  trips      TripAuthorization[]
  incidents  Incident[]
  commands   Command[]

  @@map("devices")
}

// Incidente de seguridad: hecho persistente, no derivado del ultimo evento.
// Un heartbeat posterior NO lo cierra (el ingest nunca cierra incidentes);
// solo el dueno cierra explicitamente. Idempotencia: un unico incidente OPEN
// por (deviceId, kind) — garantizada en codigo dentro de la tx del ingest,
// que es de escritor unico por dispositivo (guardado por lastSeq).
model Incident {
  id                String        @id @default(cuid())
  deviceId          String
  device            Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind              IncidentKind
  state             IncidentState @default(OPEN)
  openedAt          DateTime      @default(now())
  acknowledgedAt    DateTime?
  closedAt          DateTime?
  openedByEventSeq  Int // seq del evento que lo abrio (trazabilidad)
  // seq del evento que lo cerro (cierre por recuperacion observada); null si
  // el cierre fue manual (closeIncident) o por autorizacion de viaje.
  closedByEventSeq  Int?

  @@index([deviceId, state])
  @@map("incidents")
}

// kinds (ALLOWED_TYPES del contrato v2):
// suspected_movement | battery_low | power_lost | heartbeat | gnss_fix
model DeviceEvent {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  seq        Int
  kind       String
  observedAt DateTime
  receivedAt DateTime @default(now())
  payload    Json?

  @@unique([deviceId, seq]) // anti-replay: secuencia monotonica por dispositivo
  @@index([deviceId, observedAt])
  @@map("device_events")
}

model TripAuthorization {
  id        String    @id @default(cuid())
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedBy String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([deviceId, startedAt])
  @@map("trip_authorizations")
}

// Comando hacia el dispositivo (ver enum CommandType). Un unico LOCATE_NOW
// PENDING por dispositivo lo garantiza el servicio, no un unique index: el
// estado de carrera se cierra con updateMany/create dentro de tx corta.
model Command {
  id            String        @id @default(cuid())
  deviceId      String
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type          CommandType
  status        CommandStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  ackedAt       DateTime?
  // gnss_fix que resolvio el comando (correlacion por commandId).
  resultEventId String?

  @@index([deviceId, status])
  @@map("commands")
}

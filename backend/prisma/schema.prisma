// Guardian schema: Better Auth tables + dominio Guardian.
// Las tablas user/session/account/verification las genera/consume Better Auth
// (npx @better-auth/cli generate --adapter prisma si cambia la version).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Better Auth ============

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  devices       Device[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============ Dominio Guardian ============

enum DeviceState {
  ARMED // aparcado y armado
  TRIP // viaje autorizado activo
  WORKSHOP // modo taller temporal
}

// Handshake de confirmacion del viaje. Separado de DeviceState: el modo
// (ARMED/TRIP/WORKSHOP) es el estado de seguridad; tripState rastrea si el
// desarme fue solicitado y confirmado. Sin canal ACK con el dispositivo aun,
// el backend auto-confirma (CONFIRMED) — ver startTrip. Contrato listo para
// el ACK fisico (PR futuro): nunca se finge confirmacion de dispositivo.
enum TripState {
  IDLE // sin viaje
  REQUESTED // solicitado, pendiente de confirmar
  CONFIRMED // confirmado (hoy: por el backend)
}

enum IncidentKind {
  suspected_movement
  power_lost
}

enum IncidentState {
  OPEN // abierto, sin revisar
  ACKNOWLEDGED // "Revisado" por el dueno — NO desarma
  CLOSED // cerrado explicitamente
}

model Device {
  id         String      @id @default(cuid())
  name       String
  // Clave HMAC del dispositivo. Necesaria en claro para verificar firmas
  // del envelope (protocol.py). TODO v1.x: cifrar en reposo.
  secret     String
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  state      DeviceState @default(ARMED)
  // Handshake del viaje (ver enum TripState). workshopUntil expira el modo
  // taller: mientras exista, el dispositivo esta en WORKSHOP, nunca ARMED.
  tripState     TripState @default(IDLE)
  workshopUntil DateTime?
  lastSeq    Int         @default(0)
  lastSeenAt DateTime?
  // Ultimo estado denormalizado: evita escanear device_events para la
  // "ultima posicion/bateria conocida" (dashboard + preview de mapa).
  lastLat       Float?
  lastLon       Float?
  lastFixAt     DateTime?
  lastBatteryMv Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  events     DeviceEvent[]
  trips      TripAuthorization[]
  incidents  Incident[]

  @@map("devices")
}

// Incidente de seguridad: hecho persistente, no derivado del ultimo evento.
// Un heartbeat posterior NO lo cierra (el ingest nunca cierra incidentes);
// solo el dueno cierra explicitamente. Idempotencia: un unico incidente OPEN
// por (deviceId, kind) — garantizada en codigo dentro de la tx del ingest,
// que es de escritor unico por dispositivo (guardado por lastSeq).
model Incident {
  id                String        @id @default(cuid())
  deviceId          String
  device            Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind              IncidentKind
  state             IncidentState @default(OPEN)
  openedAt          DateTime      @default(now())
  acknowledgedAt    DateTime?
  closedAt          DateTime?
  openedByEventSeq  Int // seq del evento que lo abrio (trazabilidad)

  @@index([deviceId, state])
  @@map("incidents")
}

// kinds (protocol.py ALLOWED_TYPES):
// suspected_movement | battery_low | power_lost | heartbeat | gnss_fix
model DeviceEvent {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  seq        Int
  kind       String
  observedAt DateTime
  receivedAt DateTime @default(now())
  payload    Json?

  @@unique([deviceId, seq]) // anti-replay: secuencia monotonica por dispositivo
  @@index([deviceId, observedAt])
  @@map("device_events")
}

model TripAuthorization {
  id        String    @id @default(cuid())
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedBy String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([deviceId, startedAt])
  @@map("trip_authorizations")
}

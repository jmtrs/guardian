# ============================================
# Guardian Backend - Environment Variables
# ============================================
# cp .env.example .env
# ============================================

# PostgreSQL (docker-compose local)
DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian?schema=public

# Puerto API
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Cifrado en reposo del secreto del dispositivo (K_root), AES-256-GCM.
# 32 bytes en hex (64 chars) o base64. Genera: openssl rand -hex 32
# En produccion es OBLIGATORIO (el arranque falla si falta). En desarrollo,
# si se deja vacio, el secreto se guarda en claro (banco local).
GUARDIAN_SECRET_KEY=

# CORS + trustedOrigins: origenes extra separados por coma (dominio web prod,
# IP de LAN para Expo Go). En produccion SOLO se admiten guardian:// y estos.
TRUSTED_ORIGINS=

# Retencion de historial: dias que se conservan los eventos del dispositivo
# (con su ubicacion). Mas viejos se purgan a diario. Por defecto 90. Los
# incidentes de seguridad NO caducan.
RETENTION_DAYS=90

# Ventana de pairing: minutos que vale el codigo de claim tras aprovisionar un
# dispositivo. Por defecto 15. Fuera de la ventana el claim se rechaza.
PAIRING_WINDOW_MIN=15

# Email OTP: en desarrollo se usa el codigo fijo documentado y se muestra por
# consola. Produccion usa Resend y falla de forma cerrada si no esta configurado.
RESEND_API_KEY=
EMAIL_FROM=Guardian <onboarding@resend.dev>

# Bypass temporal de login en produccion: ambos valores son obligatorios para
# activarlo. Solo el email exacto puede usar ese codigo; ningun OTP se registra.
# Elimina ambos valores en cuanto Resend este configurado.
TEMP_LOGIN_OTP_EMAIL=
TEMP_LOGIN_OTP_CODE=

NODE_ENV=development

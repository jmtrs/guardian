# ============================================
# Guardian Backend - Environment Variables
# ============================================
# cp .env.example .env
# ============================================

# PostgreSQL (docker-compose local)
DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian?schema=public

# Puerto API
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Email OTP: en desarrollo se usa el codigo fijo documentado y se muestra
# por consola. Produccion falla de forma cerrada hasta implementar un transporte
# real de email; estas variables quedan reservadas para esa integracion futura.
RESEND_API_KEY=
EMAIL_FROM=Guardian <onboarding@resend.dev>

NODE_ENV=development

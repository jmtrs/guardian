# ============================================
# Guardian Backend - Environment Variables
# ============================================
# cp .env.example .env
# ============================================

# PostgreSQL (docker-compose local)
DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian?schema=public

# Puerto API
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Email OTP: en dev se loguea el codigo por consola.
# Produccion: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Guardian <onboarding@resend.dev>

NODE_ENV=development
